# SimVault Ubuntu VPS Configuration (copy to .env — never commit real secrets)

# Runtime environment ("production" on Ubuntu VPS, "development" locally)
NODE_ENV="production"
HOST="0.0.0.0"
PORT="3000"

# Public URLs (set to your VPS domain with HTTPS, e.g. https://sms.yourdomain.com)
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000"

# Persistent SQLite & Runtime Key Storage Paths
SIMVAULT_DB_PATH="./data/simvault.db"
SIMVAULT_KEYS_PATH="./data/.simvault.keys"

# Cryptographic Secrets (generate each with: openssl rand -hex 32)
# If left blank, SimVault auto-generates and persists them in SIMVAULT_KEYS_PATH.
JWT_PRIVATE_KEY=""
API_KEY_PEPPER=""
OTP_PEPPER=""
FIELD_ENCRYPTION_KEY=""

# Optional First-Boot Owner Credentials (used only when database has zero users)
SIMVAULT_ADMIN_EMAIL="owner@simvault.local"
SIMVAULT_ADMIN_PASSWORD="SimVault!2026"

LOG_LEVEL="info"
