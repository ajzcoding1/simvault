# ==============================================================================
# SimVault Environment Configuration (.env.example)
# Copy this file to .env for local use, OR set the active variables in:
# Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE — SUPABASE POSTGRESQL (Choose EITHER Option A OR Option B)
# ------------------------------------------------------------------------------

# --- Option A (Recommended): Full Transaction Pooler URI (port 6543) ---
# Get from: Supabase Dashboard -> Connect -> Connection String (URI) -> Transaction pooler
# Format: postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
# Aliases also auto-detected (including Vercel-Supabase integration's POSTGRES_URL):
# DATABASE_URL=
# POSTGRES_URL=

# --- Option B: Separate Supabase Fields (Auto-encodes special password chars) ---
# Leave SUPABASE_DB_URL empty if you prefer filling these 3 fields instead:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_DB_PASSWORD=your_database_password
# SUPABASE_DB_REGION=ap-south-1
# Optional override if your pooler hostname uses aws-1-... or a custom pooler host:
# SUPABASE_DB_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com

# ------------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION KEYS (REQUIRED for Vercel — min 16 chars, use 64 hex)
# ------------------------------------------------------------------------------
# Generate 4 separate values via: openssl rand -hex 32
# IMPORTANT: Do NOT change these after deployment, or existing keys/tokens/data cannot be verified/decrypted.
API_KEY_PEPPER=
JWT_PRIVATE_KEY=
OTP_PEPPER=
FIELD_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. OWNER DASHBOARD LOGIN (REQUIRED for Production)
# ------------------------------------------------------------------------------
# Owner email & password used to sign in to the SimVault web dashboard
SIMVAULT_ADMIN_EMAIL=
SIMVAULT_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. VERCEL CRON SECURITY (RECOMMENDED for Vercel)
# ------------------------------------------------------------------------------
# Random secret (`openssl rand -hex 24`) to protect GET /api/cron/sweeper
CRON_SECRET=

# ------------------------------------------------------------------------------
# 5. LOCAL / VPS ONLY (Do NOT set these on Vercel)
# ------------------------------------------------------------------------------
# SQLite database path when Supabase Postgres is not configured (default: ./data/simvault.db)
# SIMVAULT_DB_PATH=./data/simvault.db

# Local key file path when crypto env vars above are empty (default: ./data/.simvault.keys)
# SIMVAULT_KEYS_PATH=./data/.simvault.keys

# Node server bind host & port for local/VPS runs (Vercel manages these automatically)
# HOST=0.0.0.0
# PORT=3000

# Base URLs & logging (optional, for self-hosted/VPS reverse-proxy setups)
# APP_BASE_URL=https://sms.yourdomain.com
# API_BASE_URL=https://sms.yourdomain.com/v1
# LOG_LEVEL=info